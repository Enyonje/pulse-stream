# Kafka broker address inside docker network
KAFKA_BROKER=redpanda:9092

# Upstream services inside docker network
USER_PREFS_URL=http://user-prefs:3000
EXCHANGE_API_URL=http://exchange-proxy:4000

# HTTP server
PORT=3004

# Kafka topics
TRADE_SIGNALS_TOPIC=trade.signals
TRADES_EXECUTED_TOPIC=trades.executed

# Executor settings
EXECUTOR_NAME=default-executor
REQUEST_TIMEOUT_MS=8000