datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id        String   @id @default(uuid())
  symbol    String
  status    String
  createdAt DateTime @default(now())
}

model Metric {
  id        String   @id @default(uuid())
  jobId     String
  value     Float
  createdAt DateTime @default(now())
}
